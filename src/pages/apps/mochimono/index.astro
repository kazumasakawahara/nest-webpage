---
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>もちものチェッカー</title>
    <meta
      name="description"
      content="朝の持ち物確認を、指一本で。「通所の日」「通院の日」「おでかけ」のリストを選んで、大きなボタンでチェック。全部そろったら「よし、出発！」。記録は端末の中だけに残ります。"
    />
    <link rel="manifest" href="/apps/mochimono/manifest.webmanifest" />
    <meta name="theme-color" content="#4a8c3f" />
    <link rel="apple-touch-icon" href="/apps/mochimono/icons/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="もちもの" />
    <style is:global>
      /* Standalone app: does NOT import the site global.css.
         Palette is shared with kizuki / tsutaeru (sibling apps). */
      :root {
        --cream: #faf6ef;
        --ink: #333333;
        --ink-soft: #5f5847;
        --green: #4a8c3f;
        --green-dark: #2f5d3a;
        --green-pale: #eef4ea;
        --terra: #d97757;
        --terra-dark: #b4552d;
        --line: #e6ddca;
        --card: #ffffff;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --cream: #23211c;
          --ink: #f0ece2;
          --ink-soft: #b8b09c;
          --green: #6cb45e;
          --green-dark: #8fce82;
          --green-pale: #2c3a28;
          --line: #454035;
          --card: #2e2b24;
        }
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; }
      body {
        background: var(--cream);
        color: var(--ink);
        font-family: system-ui, -apple-system, 'Hiragino Kaku Gothic ProN',
          'Yu Gothic', 'Meiryo', sans-serif;
        -webkit-text-size-adjust: 100%;
        line-height: 1.6;
      }
      #app {
        max-width: 560px;
        margin: 0 auto;
        min-height: 100vh;
        padding: 20px 16px 48px;
        display: flex;
        flex-direction: column;
        gap: 16px;
      }
      button {
        font-family: inherit;
        color: inherit;
        cursor: pointer;
        touch-action: manipulation;
        border: none;
        background: none;
        padding: 0;
      }
      button:focus-visible { outline: 3px solid var(--terra); outline-offset: 2px; }

      header h1 {
        font-size: 24px;
        margin: 0;
        color: var(--green-dark);
      }
      .date { font-size: 15px; color: var(--ink-soft); }

      .tabs { display: flex; gap: 8px; flex-wrap: wrap; }
      .tab {
        font-size: 17px;
        font-weight: 700;
        padding: 10px 18px;
        border-radius: 999px;
        border: 2px solid var(--green);
        color: var(--green-dark);
        background: var(--card);
      }
      .tab[aria-selected="true"] { background: var(--green); color: #fff; }

      .progress {
        font-size: 18px;
        font-weight: 700;
        color: var(--ink-soft);
        min-height: 28px;
      }

      .items { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; }
      .item {
        display: flex;
        align-items: center;
        gap: 14px;
        width: 100%;
        min-height: 68px;
        padding: 12px 16px;
        border-radius: 16px;
        border: 2px solid var(--line);
        background: var(--card);
        font-size: 22px;
        font-weight: 700;
        text-align: left;
      }
      .item .mark {
        flex: none;
        width: 36px; height: 36px;
        border-radius: 50%;
        border: 3px solid var(--line);
        display: inline-flex; align-items: center; justify-content: center;
        font-size: 22px;
        color: transparent;
      }
      .item[aria-pressed="true"] {
        border-color: var(--green);
        background: var(--green-pale);
      }
      .item[aria-pressed="true"] .mark {
        border-color: var(--green);
        background: var(--green);
        color: #fff;
      }
      .item .del {
        margin-left: auto;
        flex: none;
        width: 40px; height: 40px;
        border-radius: 50%;
        border: 2px solid var(--terra);
        color: var(--terra-dark);
        font-size: 20px;
        font-weight: 700;
        display: none;
        align-items: center; justify-content: center;
      }
      body.editing .item .del { display: inline-flex; }

      .banner {
        display: none;
        text-align: center;
        font-size: 26px;
        font-weight: 800;
        color: #fff;
        background: var(--green);
        border-radius: 16px;
        padding: 18px;
      }
      body.done .banner { display: block; animation: pop 0.25s ease; }
      @keyframes pop { from { transform: scale(0.9); opacity: 0; } to { transform: scale(1); opacity: 1; } }
      @media (prefers-reduced-motion: reduce) { * { animation: none !important; } }

      .toolbar { display: flex; gap: 10px; flex-wrap: wrap; }
      .btn-sub {
        font-size: 15px;
        padding: 10px 16px;
        border-radius: 12px;
        border: 2px solid var(--line);
        background: var(--card);
        color: var(--ink-soft);
        font-weight: 700;
      }
      body.editing #editBtn { border-color: var(--terra); color: var(--terra-dark); }

      .addrow { display: none; gap: 8px; }
      body.editing .addrow { display: flex; }
      .addrow input {
        flex: 1;
        font-family: inherit;
        font-size: 18px;
        padding: 12px;
        border-radius: 12px;
        border: 2px solid var(--line);
        background: var(--card);
        color: var(--ink);
        min-width: 0;
      }
      .addrow button {
        font-size: 16px;
        font-weight: 700;
        padding: 12px 18px;
        border-radius: 12px;
        background: var(--green);
        color: #fff;
      }

      footer {
        margin-top: auto;
        font-size: 13px;
        color: var(--ink-soft);
        border-top: 1px solid var(--line);
        padding-top: 14px;
        line-height: 1.8;
      }
      footer a { color: var(--green-dark); }
    </style>
  </head>
  <body>
    <div id="app">
      <header>
        <h1>🎒 もちものチェッカー</h1>
        <div class="date" id="today"></div>
      </header>

      <nav class="tabs" id="tabs" aria-label="リストえらび"></nav>

      <div class="progress" id="progress" role="status"></div>
      <div class="banner" id="banner">よし、出発！ 🎉</div>

      <ul class="items" id="items"></ul>

      <div class="addrow">
        <input id="newItem" type="text" maxlength="20" placeholder="ふやす もちもの（例：かさ）" />
        <button id="addBtn" type="button">追加</button>
      </div>

      <div class="toolbar">
        <button class="btn-sub" id="resetBtn" type="button">チェックをぜんぶ戻す</button>
        <button class="btn-sub" id="editBtn" type="button">リストを編集</button>
      </div>

      <footer>
        チェックは日付が変わると自動でリセットされます。データは<strong>この端末の中だけ</strong>に保存され、どこにも送られません。<br />
        つくったのは <a href="https://nponest.com/ai-tips/">NPO法人nest「教えてAIさん」</a> のAIチームです。
      </footer>
    </div>

    <script is:inline>
      (() => {
        const KEY = 'mochimono-v1';
        const DEFAULTS = {
          lists: [
            { id: 'day', name: '通所の日', items: ['📓 連絡帳', '🥤 水筒', '🧺 タオル', '🍱 お弁当', '👒 ぼうし'] },
            { id: 'hosp', name: '通院の日', items: ['💳 保険証', '🎫 診察券', '📔 お薬手帳', '👛 お金'] },
            { id: 'out', name: 'おでかけ', items: ['👛 さいふ', '📱 スマホ', '🔑 かぎ', '🧣 ハンカチ'] },
          ],
          checks: {},
          day: '',
          active: 'day',
        };

        const todayStr = () => {
          const d = new Date();
          return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
        };

        let state;
        try { state = Object.assign({}, DEFAULTS, JSON.parse(localStorage.getItem(KEY) || '{}')); }
        catch { state = structuredClone(DEFAULTS); }
        // 日付が変わっていたらチェックだけリセット
        if (state.day !== todayStr()) { state.checks = {}; state.day = todayStr(); }
        const save = () => localStorage.setItem(KEY, JSON.stringify(state));
        save();

        const $ = (id) => document.getElementById(id);
        const list = () => state.lists.find((l) => l.id === state.active) || state.lists[0];
        const checked = () => state.checks[state.active] || [];

        const WEEK = ['日', '月', '火', '水', '木', '金', '土'];
        const d = new Date();
        $('today').textContent = `${d.getMonth() + 1}月${d.getDate()}日（${WEEK[d.getDay()]}）`;

        function render() {
          const tabs = $('tabs');
          tabs.innerHTML = '';
          state.lists.forEach((l) => {
            const b = document.createElement('button');
            b.className = 'tab';
            b.type = 'button';
            b.textContent = l.name;
            b.setAttribute('aria-selected', String(l.id === state.active));
            b.onclick = () => { state.active = l.id; save(); render(); };
            tabs.appendChild(b);
          });

          const ul = $('items');
          ul.innerHTML = '';
          const done = checked();
          list().items.forEach((name) => {
            const li = document.createElement('li');
            const b = document.createElement('button');
            b.className = 'item';
            b.type = 'button';
            b.setAttribute('aria-pressed', String(done.includes(name)));
            b.innerHTML = `<span class="mark">✓</span><span>${name}</span>`;
            b.onclick = () => {
              const arr = state.checks[state.active] || (state.checks[state.active] = []);
              const i = arr.indexOf(name);
              i >= 0 ? arr.splice(i, 1) : arr.push(name);
              save(); render();
            };
            const del = document.createElement('button');
            del.className = 'del';
            del.type = 'button';
            del.textContent = '✕';
            del.setAttribute('aria-label', `${name} をリストから消す`);
            del.onclick = (e) => {
              e.stopPropagation();
              list().items = list().items.filter((n) => n !== name);
              save(); render();
            };
            b.appendChild(del);
            li.appendChild(b);
            ul.appendChild(li);
          });

          const total = list().items.length;
          const n = done.filter((name) => list().items.includes(name)).length;
          const allDone = total > 0 && n === total;
          $('progress').textContent = allDone ? 'ぜんぶそろった！' : `あと ${total - n} こ（${n}／${total}）`;
          document.body.classList.toggle('done', allDone);
          if (allDone && navigator.vibrate) navigator.vibrate(120);
        }

        $('resetBtn').onclick = () => { state.checks[state.active] = []; save(); render(); };
        $('editBtn').onclick = () => {
          document.body.classList.toggle('editing');
          $('editBtn').textContent = document.body.classList.contains('editing') ? '編集をおわる' : 'リストを編集';
        };
        // よくある持ち物の絵文字辞書（部分一致）。見つからなければ絵文字なしで登録
        const EMOJI = [
          ['連絡帳', '📓'], ['ノート', '📓'], ['筆記', '✏️'], ['ペン', '✏️'], ['えんぴつ', '✏️'],
          ['水筒', '🥤'], ['お茶', '🍵'], ['弁当', '🍱'], ['おやつ', '🍪'], ['タオル', '🧺'],
          ['ぼうし', '👒'], ['帽子', '👒'], ['かさ', '☂️'], ['傘', '☂️'], ['カッパ', '🧥'], ['上着', '🧥'],
          ['着がえ', '👕'], ['着替え', '👕'], ['くつ', '👟'], ['靴', '👟'], ['マスク', '😷'],
          ['薬', '💊'], ['くすり', '💊'], ['お薬手帳', '📔'], ['保険証', '💳'], ['マイナ', '💳'],
          ['診察券', '🎫'], ['手帳', '📔'], ['さいふ', '👛'], ['財布', '👛'], ['お金', '👛'],
          ['スマホ', '📱'], ['携帯', '📱'], ['充電', '🔌'], ['かぎ', '🔑'], ['鍵', '🔑'],
          ['ハンカチ', '🧣'], ['ティッシュ', '🧻'], ['めがね', '👓'], ['眼鏡', '👓'], ['補聴器', '🦻'],
          ['エプロン', '🧑‍🍳'], ['歯', '🪥'], ['書類', '📄'], ['印かん', '🖋️'], ['印鑑', '🖋️'], ['はんこ', '🖋️'],
        ];
        const withEmoji = (v) => {
          if (/^\p{Extended_Pictographic}/u.test(v)) return v;
          const hit = EMOJI.find(([k]) => v.includes(k));
          return hit ? `${hit[1]} ${v}` : v;
        };
        $('addBtn').onclick = () => {
          const v = $('newItem').value.trim();
          if (!v) return;
          const name = withEmoji(v);
          if (!list().items.includes(name)) list().items.push(name);
          $('newItem').value = '';
          save(); render();
        };
        $('newItem').addEventListener('keydown', (e) => { if (e.key === 'Enter') $('addBtn').click(); });

        render();

        if ('serviceWorker' in navigator) {
          navigator.serviceWorker.register('/apps/mochimono/sw.js').catch(() => {});
        }
      })();
    </script>
  </body>
</html>
