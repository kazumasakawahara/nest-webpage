---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import AiTipsQuestionBox from '../../components/AiTipsQuestionBox.astro';

const all = await getCollection('aiTips', ({ data }) => !data.draft);

const byDateDesc = (a: (typeof all)[number], b: (typeof all)[number]) =>
  b.data.date.getTime() - a.data.date.getTime() || a.id.localeCompare(b.id);

// あんしん編（読む順＝古い順。土台→守りの順に積み上がる）
// 読む順は記事本文の「前回」のつながりに合わせて明示する（日付・ファイル名順だと①②が逆になる）
const ANSHIN_ORDER = [
  '2026-07-20-not-scary-anatomy-of-fear',
  '2026-07-20-not-difficult-just-talk',
  '2026-07-28-ai-confidently-wrong',
  '2026-07-28-ai-privacy-line',
  '2026-07-28-ai-scam-shield',
  '2026-08-07-ai-free-vs-paid',
];
const anshinRank = (e: (typeof all)[number]) => {
  const i = ANSHIN_ORDER.indexOf(e.id);
  return i === -1 ? Number.MAX_SAFE_INTEGER : i;
};
const anshinItems = all
  .filter((e) => e.data.kind === 'anshin')
  .sort(
    (a, b) =>
      anshinRank(a) - anshinRank(b) ||
      a.data.date.getTime() - b.data.date.getTime() ||
      a.id.localeCompare(b.id),
  );

// 便利ワザ編（kind未指定。新しい順）
const wazaItems = all.filter((e) => !e.data.kind).sort(byDateDesc);

// 特集コーナーの所属判定：特集専属（kind===特集名）か、棚に残したままの併載（series に特集名）
type Entry = (typeof all)[number];
type FeatureId = 'dougu' | 'haiyu' | 'google' | 'asobi' | 'genko' | 'ronbun' | 'oshieru';
const inFeature = (id: FeatureId) => (e: Entry) =>
  e.data.kind === id || (e.data.series ?? []).includes(id);

// 特集・道具の入手コーナー（ファイル名の連番順）
const douguItems = all.filter(inFeature('dougu')).sort((a, b) => a.id.localeCompare(b.id));

// 特集・AIは俳優（相手役 → 会議①②③。ファイル名の日付順＝読む順）
const haiyuItems = all.filter(inFeature('haiyu')).sort((a, b) => a.id.localeCompare(b.id));

// 特集・Googleの道具箱（読む順＝道具の順。日付順ではないので明示）
const GOOGLE_ORDER = [
  '2026-07-10-gemini-canvas',
  '2026-07-10-notebooklm-slides',
  '2026-07-12-notebooklm-custom-instructions',
  '2026-07-19-ai-keys-calendar-mail',
  '2026-08-23-google-1-drive-hands',
  '2026-08-23-google-2-gem-studio',
];
const googleRank = (e: Entry) => {
  const i = GOOGLE_ORDER.indexOf(e.id);
  return i === -1 ? Number.MAX_SAFE_INTEGER : i;
};
const googleItems = all
  .filter(inFeature('google'))
  .sort((a, b) => googleRank(a) - googleRank(b) || a.id.localeCompare(b.id));

// 特集・道具箱で、あそぶ（ファイル名の連番順。記事が出るまでは近日公開の枠だけ描画）
const asobiItems = all.filter(inFeature('asobi')).sort((a, b) => a.id.localeCompare(b.id));

// 特集・原稿編（ファイル名の日付順＝読む順）
const genkoItems = all.filter(inFeature('genko')).sort((a, b) => a.id.localeCompare(b.id));

// 特集・論文編（ファイル名の日付順＝読む順）
const ronbunItems = all.filter(inFeature('ronbun')).sort((a, b) => a.id.localeCompare(b.id));

// 特集・AIさんに、教える（ファイル名の日付順＝読む順）
const oshieruItems = all.filter(inFeature('oshieru')).sort((a, b) => a.id.localeCompare(b.id));

// 相棒編：読みもの＋連載本編（ファイル名の連番順）＋実践編（日付順）
const aibouIntro = all.find((e) => e.data.kind === 'aibou');
const seriesItems = all.filter((e) => e.data.kind === 'series').sort((a, b) => a.id.localeCompare(b.id));
const practiceItems = all.filter((e) => e.data.kind === 'practice').sort((a, b) => byDateDesc(b, a));

const fmtDate = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
---

<BaseLayout
  title="教えてAIさん"
  description="福祉の現場で役立つ、PC・AIの便利な使い方を「AIに聞いてみた」かたちでご紹介します。"
>
  <Fragment slot="head">
    <link rel="alternate" type="application/rss+xml" title="教えてAIさん" href="/ai-tips/rss.xml" />
  </Fragment>
  <Hero
    eyebrow="教えてAIさん"
    title="AIに聞いてみた、<br />現場のちょっとした便利ワザ"
    lead="「パソコンやAIで、こんなことができるの？」——福祉の現場や暮らしで役立つコツを、AIに教わりながら少しずつ積み重ねていきます。"
    size="md"
    image="/images/ai-tips-hero.svg"
    imagePosition="center right"
    bright={true}
  />

  <section class="section">
    <div class="container container--narrow">
      <h2 class="section__title">3つの棚から、どうぞ</h2>
      <p class="series-lead">
        はじめての方は 🌱 あんしん編 を上から順に。慣れてきたら、💡 と 🤝 へ。
      </p>
      <ul class="picks reveal">
        <li class="picks__item">
          <a href="#anshin" class="picks__link">
            <span class="picks__role">🌱 あんしん編・全{anshinItems.length}本</span>
            <span class="picks__title">こわくない、から始める</span>
            <span class="picks__desc">不安の正体、まちがいや個人情報・詐欺への備え。AIとつきあう土台の話。</span>
          </a>
        </li>
        <li class="picks__item">
          <a href="#waza" class="picks__link">
            <span class="picks__role">💡 便利ワザ編・全{wazaItems.length}本</span>
            <span class="picks__title">今日から、ひとつ試す</span>
            <span class="picks__desc">読みきりの便利ワザ集。気になったものから、どれでも。</span>
          </a>
        </li>
        <li class="picks__item">
          <a href="#aibou" class="picks__link">
            <span class="picks__role">🤝 相棒編・全{seriesItems.length + practiceItems.length + (aibouIntro ? 1 : 0)}本</span>
            <span class="picks__title">AIを、うちの“相棒”に育てる</span>
            <span class="picks__desc">AIに道具と記憶を持たせる連載と、その実践編。</span>
          </a>
        </li>
      </ul>

      <p class="feature-intro">
        🗂 <strong>特集コーナー</strong> ― まとまりで読みたいときは、こちらから。見出しを押すと目次がひらきます。
      </p>

      {oshieruItems.length > 0 && (
        <details class="feature-box reveal" id="oshieru" open>
          <summary class="feature-box__summary">
            <span class="feature-box__eyebrow">🍵 特集コーナー・NEW</span>
            <h3 class="feature-box__title">AIさんに、教える ― 好きなことの話をしに行く（全{oshieruItems.length}回）</h3>
            <span class="feature-box__toggle" aria-hidden="true">＋</span>
          </summary>
          <div class="feature-box__body">
            <p class="feature-box__lead">
              この特集には、AIの説明が出てきません。出てくるのは、鉄道、庭、釣り、歌——<strong>誰かの「好き」の話だけ</strong>です。好きな分野では、あなたのほうがAIより詳しい。だから最初の一言は「教えて」ではなく、<strong>「私のほうが詳しいと思うけど、聞いてくれる？」</strong>。AIは、あなたの話を聞きに来た新人です。間違えたら、教えてやってください。そして話した中身は、誰かに持っていける一枚にして終わります。
            </p>
            <img class="feature-box__img" src="/images/ai-tips/oshieru-1-engawa.svg" alt="縁側に腰かけた年配の鉄道好きが「私のほうが詳しいと思うけど、聞いてくれる？」と話しかけ、隣でノートを開いた小さなAIさん人形が「聞かせてください」と答えている絵" width="640" height="400" loading="lazy" />
            <ol class="feature-box__list">
              {oshieruItems.map((item) => (
                <li class="feature-box__item">
                  <a href={`/ai-tips/${item.id}/`} class="feature-box__link">
                    <span class="feature-box__name">{item.data.title}</span>
                  </a>
                </li>
              ))}
            </ol>
            <p class="feature-box__coming">あなたの「好き」も、教えてください。次の回の題材にします——<a href="/contact/">お問い合わせフォーム</a>へ。</p>
          </div>
        </details>
      )}

      {ronbunItems.length > 0 && (
        <details class="feature-box reveal" id="ronbun">
          <summary class="feature-box__summary">
            <span class="feature-box__eyebrow">🎓 特集コーナー</span>
            <h3 class="feature-box__title">論文編 ― 研究室をまるごと道具箱に（全{ronbunItems.length}回）</h3>
            <span class="feature-box__toggle" aria-hidden="true">＋</span>
          </summary>
          <div class="feature-box__body">
            <p class="feature-box__lead">
              <a href="#genko">原稿編</a>の続編、こんどは <strong>社会福祉系の研究者</strong> 向けです。文献の山、質的データ、原稿、査読対応——研究プロジェクトまるごとを Git＋Obsidian＋AI で回します。研究の箱の作り方（第1回）、1文献1ノートと、AIが挙げる“架空文献”への防御（第2回）、逐語録とデータの線引き（第3回）、査読対応表とAI利用の申告（第4回）。福祉系ではまだ少数派の道具立てだからこそ、<strong>画面の図を見ながら一歩ずつ</strong> 進める全4回です。
            </p>
            <img class="feature-box__img" src="/images/ai-tips/ronbun-1-four-rooms.svg" alt="人形劇の舞台に描かれた「研究の箱」の間取り図。箱の中に文献ノート・分析メモ・原稿・調査の道具の4部屋が並び、箱の外に鍵のかかった戸棚が置かれ「生データは箱に入れない」と札が下がっている。AIさん人形が「箱の中は、ぜんぶ履歴が残ります」と言っている図" width="640" height="400" loading="lazy" decoding="async" />
            <ol class="feature-box__list">
              {ronbunItems.map((item) => (
                <li class="feature-box__item">
                  <a href={`/ai-tips/${item.id}/`} class="feature-box__link">
                    <span class="feature-box__name">{item.data.title}</span>
                  </a>
                </li>
              ))}
            </ol>
          </div>
        </details>
      )}

      {genkoItems.length > 0 && (
        <details class="feature-box reveal" id="genko">
          <summary class="feature-box__summary">
            <span class="feature-box__eyebrow">📝 特集コーナー</span>
            <h3 class="feature-box__title">原稿編 ―「最終版が6つある」から卒業する（全{genkoItems.length}回）</h3>
            <span class="feature-box__toggle" aria-hidden="true">＋</span>
          </summary>
          <div class="feature-box__body">
            <p class="feature-box__lead">
              実践報告や紀要、規程の改定——<strong>長い文章を、少しずつ、何度も直す人</strong>のための Git／GitHub 連載です。原稿にセーブポイントを置き（第1回）、AIの直しを差分で査読し（第2回）、共著者とのやりとりを原稿の隣に置く（第3回）。「逐語録は上げない」の線引きまで、全3回で。
            </p>
            <img class="feature-box__img" src="/images/ai-tips/genko-1-final-six.svg" alt="人形劇の舞台。研究者人形が「最終版」の札の付いた書類の山に埋もれて困り顔をし、AIさん人形がセーブポイントの旗の並んだ道を指さしている図" width="640" height="360" loading="lazy" decoding="async" />
            <ol class="feature-box__list">
              {genkoItems.map((item) => (
                <li class="feature-box__item">
                  <a href={`/ai-tips/${item.id}/`} class="feature-box__link">
                    <span class="feature-box__name">{item.data.title}</span>
                  </a>
                </li>
              ))}
            </ol>
          </div>
        </details>
      )}

      {douguItems.length > 0 && (
        <details class="feature-box reveal" id="dougu">
          <summary class="feature-box__summary">
            <span class="feature-box__eyebrow">🧰 特集コーナー</span>
            <h3 class="feature-box__title">道具の入手 ― AIの道具箱をそろえる（全{douguItems.length}回）</h3>
            <span class="feature-box__toggle" aria-hidden="true">＋</span>
          </summary>
          <div class="feature-box__body">
            <p class="feature-box__lead">
              AIを“読みものの相手”から“一緒に働く相棒”へ。専用の机（Claude Desktop）、手（Filesystem）、知恵をためるノート（Obsidian）を順に手に入れて、自分専用の“データセンター”を組み上げます。発展編では、それを“信頼できる倉庫”に育てる規律まで。ここで整う道具は、<a href="/post-parent/tools/">親なき後のツール・しくみ</a>を始めるときの土台にもなります。
            </p>
            <ol class="feature-box__list">
              {douguItems.map((item) => (
                <li class="feature-box__item">
                  <a href={`/ai-tips/${item.id}/`} class="feature-box__link">
                    <span class="feature-box__name">{item.data.title}</span>
                  </a>
                </li>
              ))}
            </ol>
          </div>
        </details>
      )}

      {googleItems.length > 0 && (
        <details class="feature-box reveal" id="google">
          <summary class="feature-box__summary">
            <span class="feature-box__eyebrow">🧰 特集コーナー</span>
            <h3 class="feature-box__title">Googleの道具箱 ― いつものGoogleで、ここまでできる（全{googleItems.length}回）</h3>
            <span class="feature-box__toggle" aria-hidden="true">＋</span>
          </summary>
          <div class="feature-box__body">
            <p class="feature-box__lead">
              <strong>Googleしか使えない職場でも、AIに道具は持たせられます。</strong>「道具の入手」で Claude にそろえた机・手・ノート・レシピカードを、Gemini と Google Workspace で一つずつ。無料の Google アカウントでできることから始めて、最後は有料の Workspace で“流れ”を組む Workspace Studio まで。どちらの道具箱を開けるかは、お使いの環境で選べます。
            </p>
            <img class="feature-box__img" src="/images/ai-tips/google-toolbox.svg" alt="Claudeの道具箱とGoogleの道具箱の対応表。机＝Claude Desktop と Gemini Canvas、手＝Filesystem と Googleドライブ、ノート＝Obsidian と Gemini Notebook、レシピカード＝スキルと Gem、目覚まし時計＝定期タスクと Workspace Studio" width="640" height="230" loading="lazy" decoding="async" />
            <ol class="feature-box__list">
              {googleItems.map((item) => (
                <li class="feature-box__item">
                  <a href={`/ai-tips/${item.id}/`} class="feature-box__link">
                    <span class="feature-box__name">{item.data.title}</span>
                  </a>
                </li>
              ))}
            </ol>
          </div>
        </details>
      )}

      <details class="feature-box reveal" id="asobi">
        <summary class="feature-box__summary">
          <span class="feature-box__eyebrow">🪁 特集コーナー</span>
          <h3 class="feature-box__title">道具箱で、あそぶ ― 道具は、そろった。さあ、あそぼう。{asobiItems.length > 0 ? `（全${asobiItems.length}回）` : '（近日公開）'}</h3>
          <span class="feature-box__toggle" aria-hidden="true">＋</span>
        </summary>
        <div class="feature-box__body">
          <p class="feature-box__lead">
            <a href="#dougu">道具の入手</a>（Claude 版）と<a href="#google">Googleの道具箱</a>（Google 版）でそろえた道具を、こんどは組み合わせて遊ぶ実演連載です。題材は<a href="/peer-activities/railway-club/">鉄道倶楽部</a>。旅の写真がかべ新聞になり、同じ材料が思い出ラジオになります。倶楽部の活動で、そのまま使えるかたちを目指します。
          </p>
          <img class="feature-box__img" src="/images/ai-tips/asobi-toolbox.svg" alt="開いた道具箱から、紙飛行機と音符が飛び出している図" width="640" height="200" loading="lazy" decoding="async" />
          {asobiItems.length > 0 ? (
            <ol class="feature-box__list">
              {asobiItems.map((item) => (
                <li class="feature-box__item">
                  <a href={`/ai-tips/${item.id}/`} class="feature-box__link">
                    <span class="feature-box__name">{item.data.title}</span>
                  </a>
                </li>
              ))}
            </ol>
          ) : (
            <p class="feature-box__coming">第1回「かべ新聞編集部」・第2回「思い出ラジオ局」——近日公開です。</p>
          )}
        </div>
      </details>

      {haiyuItems.length > 0 && (
        <details class="feature-box reveal" id="haiyu">
          <summary class="feature-box__summary">
            <span class="feature-box__eyebrow">🎭 特集コーナー</span>
            <h3 class="feature-box__title">AIは俳優 ― どんな役もこなします（全{haiyuItems.length}回）</h3>
            <span class="feature-box__toggle" aria-hidden="true">＋</span>
          </summary>
          <div class="feature-box__body">
            <p class="feature-box__lead">
              電話の相手役、なれ合わない賛成役と反対役、7人のケース会議——ぜんぶ、同じAIです。役を振ると、AIは「答える人」から「一緒に考える人」に変わります。<strong>AIは何人にでもなれる。ただし、座れない席がひとつある。</strong>——その話まで、全4回で。第1回はどのAIでも無料で試せます。
            </p>
            <img class="feature-box__img" src="/images/ai-tips/haiyu-stairs.svg" alt="役の数がふえていく階段の図。第1回は相手役1人、第2回は賛成役と反対役、第3回は7人の会議、第4回は空いた1席（ご本人の席）" width="640" height="200" loading="lazy" decoding="async" />
            <ol class="feature-box__list">
              {haiyuItems.map((item) => (
                <li class="feature-box__item">
                  <a href={`/ai-tips/${item.id}/`} class="feature-box__link">
                    <span class="feature-box__name">{item.data.title}</span>
                  </a>
                </li>
              ))}
            </ol>
          </div>
        </details>
      )}

      <a href="/ai-tips/pocket/" class="pocket-door reveal">
        <span class="pocket-door__emoji" aria-hidden="true">👝</span>
        <span class="pocket-door__body">
          <span class="pocket-door__title">AIさんのポケット ― こまりごとから、さがす</span>
          <span class="pocket-door__desc">「買ってくるのを忘れちゃった！」——こまりごとを言うと、AIさんがポケットから道具を出してくれる劇場ページです。</span>
        </span>
        <span class="pocket-door__arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  {anshinItems.length > 0 && (
    <section class="section section--sand" id="anshin">
      <div class="container container--narrow">
        <h2 class="section__title">🌱 あんしん編 ― こわくない、から始める</h2>
        <p class="series-lead">
          AIとのつきあい方の“土台”になる5本。不安の正体、まちがいとのつきあい方、個人情報の線引き、詐欺への備え。はじめての方は、上から順にどうぞ。
        </p>
        <ul class="tips-list">
          {anshinItems.map((item, i) => (
            <li class="tips-list__item reveal" data-delay={(i % 3) + 1}>
              <a href={`/ai-tips/${item.id}/`} class="tips-list__link tips-list__link--num">
                <span class="tips-list__num" aria-hidden="true">{i + 1}</span>
                <h3 class="tips-list__title">{item.data.title}</h3>
                {item.data.summary && (
                  <p class="tips-list__summary">{item.data.summary}</p>
                )}
                <span class="tips-list__arrow" aria-hidden="true">
                  <svg width="14" height="10" viewBox="0 0 14 10" fill="none">
                    <path d="M1 5h12M9 1l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="section" id="waza">
    <div class="container container--narrow">
      <h2 class="section__title">💡 便利ワザ編 ― 今日から、ひとつ試す</h2>
      <p class="series-lead">
        読みきりの便利ワザ集。順番はありません。気になったものから、ひとつ試してみてください。
      </p>
      {wazaItems.length > 0 ? (
        <ul class="tips-list">
          {wazaItems.map((item, i) => (
            <li class="tips-list__item reveal" data-delay={(i % 3) + 1}>
              <a href={`/ai-tips/${item.id}/`} class="tips-list__link">
                <time class="tips-list__date" datetime={item.data.date.toISOString()}>
                  {fmtDate(item.data.date)}
                </time>
                <h3 class="tips-list__title">{item.data.title}</h3>
                {item.data.summary && (
                  <p class="tips-list__summary">{item.data.summary}</p>
                )}
                <span class="tips-list__arrow" aria-hidden="true">
