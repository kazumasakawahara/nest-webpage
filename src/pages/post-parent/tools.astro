---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import CtaBlock from '../../components/CtaBlock.astro';
import { tools } from '../../lib/post-parent';

// 「聞く → 書く → 残す・共有する」の3段。tools 配列の step と対応する。
const flow = [
  {
    no: '1',
    step: '聞く',
    lead: '何を聞けばいいかを、決める',
    body: '親御さんの頭の中にある知恵を、ことばにするための問い集。すべてはここから始まります。',
    href: '#kikitori-guide',
  },
  {
    no: '2',
    step: '書く',
    lead: '手元に、書き留める',
    body: '聞いたことを、無料のテンプレートに書き込む。パソコン1台あれば、今日から始められます。',
    href: '#oya-inai-template',
  },
  {
    no: '3',
    step: '残す・共有する',
    lead: '支援チームで、引き継ぐ',
    body: '書いたものを構造化し、支援者が替わっても質が落ちない形にする。図としても共有できます。',
    href: '#kurashi-support',
  },
];
---
<BaseLayout
  title="ツール・しくみ｜親なき後"
  description="親の暗黙知の継承や、支援ネットワークの可視化に取り組む、nest発のしくみをご紹介します。"
>
  <PageIntro
    eyebrow="Tools & Systems"
    title="ツール・しくみ"
    lead="親なき後も支援が途切れないために。nestが取り組んでいる、知恵をつなぐためのしくみです。"
  />

  <section class="section section--tight">
    <div class="container container--narrow reveal">
      <p class="flow-intro">
        ここにあるしくみは、ばらばらの道具ではありません。<br />
        <strong>聞く → 書く → 残す・共有する</strong>という、ひとつの流れです。
      </p>

      <ol class="flowmap">
        {flow.map((f) => (
          <li class="flowmap__item">
            <a class="flowmap__link" href={f.href}>
              <span class="flowmap__no" aria-hidden="true">{f.no}</span>
              <span class="flowmap__step">{f.step}</span>
              <span class="flowmap__lead">{f.lead}</span>
              <span class="flowmap__body">{f.body}</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container container--narrow">
      {tools.map((t, i) => (
        <article id={t.id} class:list={['tool', { 'tool--alt': i % 2 === 1 }]} >
          <div class="tool__media">
            {t.video ? (
              <div class="video-embed">
                <button type="button" class="video-embed__poster" data-video-play aria-label={`${t.name} の紹介動画を再生`}>
                  <img src={t.poster ?? t.image} alt={t.imageAlt ?? `${t.name} の紹介動画`} />
                  <span class="video-embed__play" aria-hidden="true"></span>
                </button>
                <video class="video-embed__player" controls playsinline preload="none" poster={t.poster}>
                  <source src={t.video} type="video/mp4" />
                  お使いのブラウザは動画の再生に対応していません。
                </video>
              </div>
            ) : t.image
              ? <img src={t.image} alt={t.imageAlt ?? t.name} />
              : <div class="tool__placeholder" aria-hidden="true">準備中</div>}
          </div>
          <div class="tool__body">
            {t.step && <p class="tool__step"><span class="tool__step-dot" aria-hidden="true"></span>{t.step}</p>}
            <p class="tool__for">{t.forWhom}</p>
            {t.icon ? (
              <div class="tool__head">
                <img class="tool__icon" src={t.icon} alt="" width="72" height="72" loading="lazy" />
                <div class="tool__head-id">
                  <h2 class="tool__title">{t.name}</h2>
                  <p class="tool__tagline">{t.tagline}</p>
                </div>
              </div>
            ) : (
              <>
                <h2 class="tool__title">{t.name}</h2>
                <p class="tool__tagline">{t.tagline}</p>
              </>
            )}
            {t.chips && t.chips.length > 0 && (
              <p class="tool__chips" aria-label="このしくみの特徴">
                {t.chips.map((c) => <span>{c}</span>)}
              </p>
            )}
            <p class="tool__text">{t.body}</p>
            {t.manual && (
              <div class="tool__manual">
                <p class="tool__manual-label">はじめての方へ</p>
                <p class="tool__manual-intro">{t.manual.intro}</p>
                <a class="btn btn--primary btn--sm" href={t.manual.href} target="_blank" rel="noopener">
                  {t.manual.label}
                  <span class="btn__icon" aria-hidden="true">→</span>
                </a>
                {t.manual.meta && <p class="tool__manual-meta">{t.manual.meta}</p>}
              </div>
            )}
            <div class="tool__links">
              {t.links.map((l) => (
                <a class="btn btn--outline" href={l.href} {...(l.external ? { rel: 'external', target: '_blank' } : {})}>
                  {l.label}
                </a>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section section--sand">
    <div class="container">
      <CtaBlock
        title="しくみづくりにご関心のある方へ"
        body="支援者・法人の方で、こうしたしくみの活用や共同にご関心があれば、お気軽にご相談ください。"
        primary={{ label: 'お問い合わせフォーム', href: '/contact/' }}
        secondary={{ label: '親なき後トップへ', href: '/post-parent/' }}
        variant="dark"
      />
    </div>
  </section>
</BaseLayout>

<script>
  // ポスターのクリックでプレイヤーへ切り替え、再生する
  document.querySelectorAll<HTMLElement>('[data-video-play]').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const embed = trigger.closest('.video-embed');
      if (!embed) return;
      const player = embed.querySelector<HTMLVideoElement>('.video-embed__player');
      if (!player) return;
      embed.classList.add('is-playing');
      player.play();
    });
  });
</script>

<style>
  /* ===== 聞く → 書く → 残す・共有する（3段の流れ） ===== */
  .flow-intro {
    text-align: center;
    font-size: 16px;
    line-height: var(--lh-loose);
    color: var(--color-ink-mute);
    margin-bottom: var(--space-6);
  }
  .flow-intro strong {
    font-family: var(--font-hand);
    font-size: 19px;
    color: var(--color-green-900);
    font-weight: 600;
  }

  .flowmap {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
  }
  .flowmap__item { position: relative; }
  /* 項目のあいだに矢印を置く */
  .flowmap__item + .flowmap__item::before {
    content: '';
    position: absolute;
    left: calc(var(--space-5) / -2 - 4px);
    top: 42px;
    width: 8px;
    height: 8px;
    border-right: 2px solid var(--color-green-500);
    border-bottom: 2px solid var(--color-green-500);
    transform: rotate(-45deg);
  }

  .flowmap__link {
    display: grid;
    gap: var(--space-2);
    height: 100%;
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    padding: var(--space-5);
    text-decoration: none;
    transition: transform var(--dur-base) var(--ease-out), box-shadow var(--dur-base) var(--ease-out);
  }
  .flowmap__link:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-soft);
  }
  .flowmap__no {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--color-green-700);
    color: var(--color-cream);
    font-family: var(--font-serif);
    font-size: 15px;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .flowmap__step {
    font-family: var(--font-hand);
    font-size: 20px;
    color: var(--color-green-900);
    line-height: var(--lh-snug);
  }
  .flowmap__lead {
    font-size: var(--fs-small);
    font-family: var(--font-mono);
    letter-spacing: 0.04em;
    color: var(--color-green-700);
  }
  .flowmap__body {
    font-size: 14px;
    line-height: var(--lh-loose);
    color: var(--color-ink-mute);
  }

  /* カード側の段バッジ */
  .tool__step {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--color-green-700);
    background: var(--color-green-100);
    border-radius: var(--radius-pill);
    padding: 3px 12px;
    margin-bottom: var(--space-3);
  }
  .tool__step-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-green-500);
  }

  .tool {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: var(--space-6);
    align-items: center;
    margin-bottom: var(--space-8);
  }
  .tool--alt .tool__media { order: 2; }

  .tool__media img,
  .tool__placeholder {
    width: 100%;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-soft);
    display: block;
  }
  .tool__placeholder {
    aspect-ratio: 4 / 3;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-cream);
    color: var(--color-ink-soft);
    font-family: var(--font-mono);
    letter-spacing: 0.1em;
  }

  /* ===== 紹介動画（ポスター → クリックで再生） ===== */
  .video-embed {
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-soft);
    aspect-ratio: 16 / 9;
    background: var(--color-green-900);
  }
  .video-embed__poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 0;
    border: none;
    cursor: pointer;
    background: none;
    display: block;
  }
  .video-embed__poster img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    box-shadow: none;
    border-radius: 0;
    transition: transform var(--dur-base) var(--ease-out);
  }
  .video-embed__poster:hover img { transform: scale(1.03); }

  /* 中央の再生ボタン（円形 + 三角） */
  .video-embed__play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 68px;
    height: 68px;
    border-radius: 50%;
    background: rgba(16, 34, 17, 0.72);
    backdrop-filter: blur(2px);
    transition: background var(--dur-base) var(--ease-out), transform var(--dur-base) var(--ease-out);
  }
  .video-embed__play::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 54%;
    transform: translate(-50%, -50%);
    border-style: solid;
    border-width: 11px 0 11px 18px;
    border-color: transparent transparent transparent var(--color-cream);
  }
  .video-embed__poster:hover .video-embed__play,
  .video-embed__poster:focus-visible .video-embed__play {
    background: var(--color-terra-500);
    transform: translate(-50%, -50%) scale(1.08);
  }
  .video-embed__player {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
    background: var(--color-green-900);
  }
  /* 再生前はプレイヤーを隠し、再生開始でポスターを隠す（hidden属性に依存しない） */
  .video-embed:not(.is-playing) .video-embed__player { display: none; }
  .video-embed.is-playing .video-embed__poster { display: none; }

  .tool__for {
    font-size: var(--fs-small);
    color: var(--color-green-700);
    font-family: var(--font-mono);
    letter-spacing: 0.04em;
    margin-bottom: var(--space-2);
  }
  .tool__title {
    font-family: var(--font-hand);
    font-size: 24px;
    font-weight: 600;
    color: var(--color-green-900);
    margin-bottom: var(--space-2);
  }
  .tool__tagline { font-size: 16px; color: var(--color-ink); margin-bottom: var(--space-4); }

  /* ===== ストア風カード（アイコン＋特徴チップ。icon を持つツールのみ） ===== */
  .tool__head {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-3);
  }
  .tool__icon {
    flex: none;
    width: 72px;
    height: 72px;
    border-radius: 18px;
    box-shadow: var(--shadow-soft);
  }
  .tool__head-id { min-width: 0; }
  .tool__head .tool__title { margin-bottom: 4px; }
  .tool__head .tool__tagline { margin-bottom: 0; }
  .tool__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: var(--space-4);
  }
  .tool__chips span {
    font-size: 12px;
    font-weight: 700;
    color: var(--color-green-900);
    background: var(--color-green-100);
    border: 1px solid var(--color-line);
    border-radius: 999px;
    padding: 2px 10px;
  }
  .tool__text { font-size: 15px; line-height: var(--lh-normal); color: var(--color-ink-mute); margin-bottom: var(--space-5); }

  /* ===== 導入マニュアルへの誘導（福祉職に配慮した紹介文つき） ===== */
  .tool__manual {
    background: var(--color-cream);
    border: 1px solid var(--color-line);
    border-left: 4px solid var(--color-green-700);
    border-radius: var(--radius-md);
    padding: var(--space-4) var(--space-5);
    margin-bottom: var(--space-5);
  }
  .tool__manual-label {
    font-size: var(--fs-small);
    font-family: var(--font-mono);
    letter-spacing: 0.04em;
    color: var(--color-green-700);
    margin-bottom: var(--space-2);
  }
  .tool__manual-intro {
    font-size: 15px;
    line-height: var(--lh-loose);
    color: var(--color-ink);
    margin-bottom: var(--space-4);
  }
  .tool__manual-meta {
    font-size: var(--fs-small);
    color: var(--color-ink-mute);
    margin-top: var(--space-2);
  }

  .tool__links { display: flex; flex-wrap: wrap; gap: var(--space-3); }

  /* アンカー移動時、固定ヘッダーの下に隠れないように */
  .tool[id] { scroll-margin-top: var(--space-8); }

  @media (max-width: 900px) {
    .flowmap { grid-template-columns: 1fr; gap: var(--space-4); }
    .flowmap__item + .flowmap__item::before {
      left: 50%;
      top: calc(var(--space-4) / -2 - 6px);
      transform: rotate(45deg) translateX(-50%);
    }
  }

  @media (max-width: 768px) {
    .tool { grid-template-columns: 1fr; }
    .tool--alt .tool__media { order: 0; }
  }

  @media (max-width: 560px) {
    .tool__head {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
