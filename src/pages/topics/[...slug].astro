---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const items = await getCollection('topics', ({ data }) => !data.draft);
  return items.map((item) => ({
    params: { slug: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await render(item);

const fmtDate = (d: Date) =>
  `${d.getFullYear()}年${d.getMonth() + 1}月${d.getDate()}日`;
---

<BaseLayout title={item.data.title} description={item.data.summary ?? item.data.title}>
  <article class="topic-article">
    <div class="container container--narrow">
      <header class="topic-article__head reveal">
        <a href="/topics/" class="topic-article__back">
          <span aria-hidden="true">←</span> トピック 一覧へ
        </a>
        <span class="badge badge--accent">トピック</span>
        <h1 class="topic-article__title">
          {item.data.titleLines
            ? item.data.titleLines.map((line) => (
                <span class="topic-article__title-line">
                  {line.split('|').map((phrase) => <span class="topic-article__phrase">{phrase}</span>)}
                </span>
              ))
            : item.data.title}
        </h1>
        <time class="topic-article__date" datetime={item.data.date.toISOString()}>
          {fmtDate(item.data.date)}
        </time>
      </header>

      <div class="topic-article__body reveal">
        <Content />
      </div>

      <div class="topic-article__foot reveal">
        <a href="/topics/" class="btn btn--outline">一覧に戻る</a>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .topic-article {
    padding-block: var(--space-9) var(--space-8);
  }

  .topic-article__head {
    text-align: center;
    margin-bottom: var(--space-7);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-line);
  }

  .topic-article__back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 13px;
    color: var(--color-ink-mute);
    font-family: var(--font-mono);
    letter-spacing: 0.05em;
    margin-bottom: var(--space-5);
  }

  .topic-article__back:hover { color: var(--color-terra-500); }

  .topic-article__title {
    font-family: var(--font-serif);
    font-size: 32px;
    font-weight: 600;
    color: var(--color-green-900);
    line-height: 1.5;
    margin-block: var(--space-4);
  }

  /* titleLines 指定時：1行＝block、文節＝inline-block（狭い画面では文節の境目でだけ折れる） */
  .topic-article__title-line { display: block; }
  .topic-article__phrase { display: inline-block; }

  .topic-article__date {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-ink-soft);
    letter-spacing: 0.05em;
  }

  .topic-article__body {
    font-size: 16px;
    line-height: 2;
    color: var(--color-ink);
  }

  .topic-article__body :global(p) { margin-bottom: var(--space-5); }
  .topic-article__body :global(h2) {
    font-size: 22px;
    margin-top: var(--space-7);
    margin-bottom: var(--space-3);
    color: var(--color-green-900);
    scroll-margin-top: 80px; /* モバイルの固定トップバーに隠れないように */
  }
  .topic-article__body :global(h3) {
    font-size: 18px;
    margin-top: var(--space-5);
    margin-bottom: var(--space-3);
    color: var(--color-green-900);
  }
  .topic-article__body :global(ul),
  .topic-article__body :global(ol) {
    padding-left: 1.6em;
    margin-bottom: var(--space-5);
  }
  .topic-article__body :global(ul) { list-style: disc; }
  .topic-article__body :global(ol) { list-style: decimal; }
  .topic-article__body :global(li) { margin-bottom: var(--space-2); }
  .topic-article__body :global(a) {
    color: var(--color-green-700);
    border-bottom: 1px solid currentColor;
  }
  .topic-article__body :global(a:hover) {
    color: var(--color-terra-500);
  }
  .topic-article__body :global(strong) {
    color: var(--color-green-900);
    font-weight: 600;
  }
  .topic-article__body :global(img) {
    max-width: 100%;
    height: auto;
  }
  .topic-article__body :global(hr) {
    border: none;
    border-top: 1px solid var(--color-line);
    margin: var(--space-7) 0 var(--space-5);
  }

  /* 目次 */
  .topic-article__body :global(.topic-toc) {
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    padding: var(--space-4) var(--space-5);
    margin: var(--space-6) 0;
  }
  .topic-article__body :global(.topic-toc__title) {
    font-family: var(--font-serif);
    font-size: 14px;
    font-weight: 600;
    color: var(--color-green-900);
    letter-spacing: 0.08em;
    margin: 0 0 var(--space-2);
  }
  .topic-article__body :global(.topic-toc__list) {
    list-style: none;
    padding-left: 0;
    margin: 0;
  }
  .topic-article__body :global(.topic-toc__list li) {
    margin: 0;
    border-top: 1px solid var(--color-line-soft);
  }
  .topic-article__body :global(.topic-toc__list a) {
    display: block;
    padding: var(--space-2) var(--space-1);
    font-size: 14px;
    line-height: 1.7;
    color: var(--color-green-700);
    border-bottom: none;
  }
  .topic-article__body :global(.topic-toc__list a:hover) {
    color: var(--color-terra-500);
    background-color: rgba(74, 140, 63, 0.04);
  }

  /* 法律名の枠 */
  .topic-article__body :global(.topic-lawref) {
    font-family: var(--font-serif);
    font-size: 14px;
    color: var(--color-ink-mute);
    line-height: 1.9;
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    padding: var(--space-4) var(--space-5);
    margin-bottom: var(--space-5);
  }

  /* 施行スケジュール */
  .topic-article__body :global(.topic-schedule) {
    border-left: 3px solid var(--color-green-700);
    padding: var(--space-1) 0 var(--space-1) var(--space-5);
    margin: var(--space-5) 0 var(--space-6);
  }
  .topic-article__body :global(.topic-schedule dl) {
    margin: 0;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 6px 20px;
    font-size: 14px;
    line-height: 1.8;
  }
  .topic-article__body :global(.topic-schedule dt) {
    font-family: var(--font-serif);
    white-space: nowrap;
    color: var(--color-green-700);
    font-weight: 600;
  }
  .topic-article__body :global(.topic-schedule dd) { margin: 0; }
  @media (max-width: 600px) {
    .topic-article__body :global(.topic-schedule dl) { grid-template-columns: 1fr; gap: 2px; }
    .topic-article__body :global(.topic-schedule dd) { margin-bottom: var(--space-2); }
  }

  /* 図版 */
  .topic-article__body :global(.topic-figure) {
    margin: var(--space-6) 0;
  }
  .topic-article__body :global(.topic-figure img) {
    display: block;
    width: 100%;
    height: auto;
    background: var(--color-paper);
    border: 1px solid var(--color-line-soft);
    border-radius: var(--radius-md);
    padding: var(--space-4);
  }
  .topic-article__body :global(.topic-figure figcaption) {
    margin-top: var(--space-2);
    font-size: 13px;
    color: var(--color-ink-mute);
    line-height: 1.7;
  }

  /* 条文の新旧対照 */
  .topic-article__body :global(.taisho) {
    margin: var(--space-5) 0;
    border: 1px solid var(--color-line);
    background: var(--color-paper);
  }
  .topic-article__body :global(.taisho-head) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    font-size: 13px;
    border-bottom: 1px solid var(--color-line);
  }
  .topic-article__body :global(.taisho-head div) {
    padding: 7px 14px;
    font-family: var(--font-serif);
  }
  .topic-article__body :global(.taisho-head .new) {
    background: var(--color-green-100);
    color: var(--color-green-700);
    border-right: 1px solid var(--color-line);
  }
  .topic-article__body :global(.taisho-head .old) {
    background: var(--color-sand);
    color: var(--color-ink-mute);
  }
  .topic-article__body :global(.taisho-body) {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  .topic-article__body :global(.taisho-body > div) {
    padding: var(--space-4) var(--space-4) 18px;
    font-family: var(--font-serif);
    font-size: 14px;
    line-height: 1.9;
  }
  .topic-article__body :global(.taisho-body .new) { border-right: 1px solid var(--color-line); }
  .topic-article__body :global(.taisho-body .old) {
    color: var(--color-ink-mute);
    background: #fcfbf8;
  }
  .topic-article__body :global(.taisho b) {
    background: linear-gradient(transparent 62%, #f3e2a8 62%);
    font-weight: 600;
    color: inherit;
  }
  .topic-article__body :global(.taisho .old b) {
    background: linear-gradient(transparent 62%, #e8e2d4 62%);
    font-weight: 400;
  }
  .topic-article__body :global(.taisho .kesu) {
    color: var(--color-terra-700);
    font-family: var(--font-sans);
    font-size: 12.5px;
    margin: var(--space-3) 0 0;
  }
  .topic-article__body :global(.taisho .jo) {
    font-weight: 600;
    display: block;
    margin-bottom: 2px;
  }
  @media (max-width: 640px) {
    .topic-article__body :global(.taisho-head) { grid-template-columns: 1fr; }
    .topic-article__body :global(.taisho-head .new) {
      border-right: none;
      border-bottom: 1px solid var(--color-line);
    }
    .topic-article__body :global(.taisho-body) { grid-template-columns: 1fr; }
    .topic-article__body :global(.taisho-body .new) {
      border-right: none;
      border-bottom: 1px solid var(--color-line);
    }
  }

  /* 読みどころ／注意ブロック */
  .topic-article__body :global(.point) {
    background: var(--color-green-100);
    border-left: 3px solid var(--color-green-700);
    padding: var(--space-4) var(--space-5);
    margin: var(--space-5) 0;
    font-size: 15px;
    line-height: 1.9;
  }
  .topic-article__body :global(.point p) { margin: 0; }
  .topic-article__body :global(.point p + p) { margin-top: var(--space-3); }
  .topic-article__body :global(.point b) {
    font-weight: 600;
    color: var(--color-green-900);
  }
  .topic-article__body :global(.chui) {
    background: var(--color-terra-100);
    border-left: 3px solid var(--color-terra-500);
    padding: var(--space-4) var(--space-5);
    margin: var(--space-5) 0;
    font-size: 15px;
    line-height: 1.9;
  }
  .topic-article__body :global(.chui p) { margin: 0; }
  .topic-article__body :global(.chui strong) { color: var(--color-terra-700); }

  /* 表（Markdownテーブル） */
  .topic-article__body :global(table) {
    border-collapse: collapse;
    width: 100%;
    font-size: 14px;
    line-height: 1.8;
    margin: var(--space-5) 0;
  }
  .topic-article__body :global(th),
  .topic-article__body :global(td) {
    border-bottom: 1px solid var(--color-line);
    padding: var(--space-3) var(--space-3);
    text-align: left;
    vertical-align: top;
  }
  .topic-article__body :global(th) {
    font-family: var(--font-serif);
    font-weight: 600;
    white-space: nowrap;
  }
  .topic-article__body :global(thead th) {
    border-bottom: 1.5px solid var(--color-green-900);
  }
  @media (max-width: 640px) {
    .topic-article__body :global(table) { display: block; overflow-x: auto; }
  }

  /* ノート風の部品（目印つきの囲み・要点カード・いま→案・チェックリスト） */
  .topic-article__body :global(mark) {
    background: linear-gradient(transparent 58%, var(--color-terra-100) 58%);
    color: inherit;
    padding: 0 1px;
  }
  .topic-article__body :global(.note-lead) {
    font-family: var(--font-serif);
    font-size: 17px;
    line-height: 1.9;
    color: var(--color-green-900);
    margin: var(--space-3) 0 var(--space-5);
    padding-left: var(--space-4);
    border-left: 4px solid var(--color-green-500);
  }
  .topic-article__body :global(.note-summary) {
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    padding: var(--space-5);
    margin: var(--space-6) 0;
  }
  .topic-article__body :global(.note-summary__title) {
    font-family: var(--font-serif);
    font-weight: 600;
    color: var(--color-green-900);
    margin: 0 0 var(--space-4);
    letter-spacing: 0.06em;
  }
  .topic-article__body :global(.note-summary__grid) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
  }
  .topic-article__body :global(.note-card) {
    background: var(--color-cream);
    border: 1px solid var(--color-line-soft);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    font-size: 14px;
    line-height: 1.8;
  }
  .topic-article__body :global(.note-card p) { margin: 0; }
  .topic-article__body :global(.note-card__num) {
    display: inline-block;
    font-family: var(--font-serif);
    font-size: 12px;
    color: var(--color-terra-700);
    letter-spacing: 0.08em;
  }
  .topic-article__body :global(.note-card__name) {
    display: block;
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 15px;
    color: var(--color-green-900);
    margin: 2px 0 4px;
  }
  .topic-article__body :global(.note-card a) { font-size: 13px; }
  .topic-article__body :global(.note-mark) {
    position: relative;
    border-radius: var(--radius-md);
    padding: var(--space-5) var(--space-5) var(--space-4);
    margin: var(--space-6) 0 var(--space-5);
    font-size: 15px;
    line-height: 1.9;
    border: 1.5px solid var(--color-green-500);
    background: #fff;
  }
  .topic-article__body :global(.note-mark p) { margin: 0; }
  .topic-article__body :global(.note-mark p + p) { margin-top: var(--space-2); }
  .topic-article__body :global(.note-mark__label) {
    position: absolute;
    top: -0.9em;
    left: var(--space-4);
    font-family: var(--font-serif);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.06em;
    padding: 2px 12px;
    border-radius: 999px;
    color: #fff;
    background: var(--color-green-700);
  }
  .topic-article__body :global(.note-mark--chui) {
    border-color: var(--color-terra-500);
    background: var(--color-terra-100);
  }
  .topic-article__body :global(.note-mark--chui .note-mark__label) { background: var(--color-terra-500); }
  .topic-article__body :global(.note-mark--kazoku) {
    border-color: var(--color-terra-300);
    background: var(--color-cream);
  }
  .topic-article__body :global(.note-mark--kazoku .note-mark__label) { background: var(--color-terra-700); }
  .topic-article__body :global(.note-mark--memo) {
    border: 1.5px dashed var(--color-ink-mute);
    background: var(--color-paper);
  }
  .topic-article__body :global(.note-mark--memo .note-mark__label) { background: var(--color-ink-soft); }
  .topic-article__body :global(.note-compare) {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: stretch;
    gap: var(--space-2);
    margin: var(--space-5) 0;
    font-size: 14px;
    line-height: 1.8;
  }
  .topic-article__body :global(.note-compare__box) {
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    background: var(--color-paper);
  }
  .topic-article__body :global(.note-compare__box--new) {
    border-color: var(--color-green-500);
    background: var(--color-green-100);
  }
  .topic-article__body :global(.note-compare__box p) { margin: 0; }
  .topic-article__body :global(.note-compare__tag) {
    display: block;
    font-family: var(--font-serif);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--color-ink-mute);
    margin-bottom: 4px;
  }
  .topic-article__body :global(.note-compare__box--new .note-compare__tag) { color: var(--color-green-700); }
  .topic-article__body :global(.note-compare__arrow) {
    align-self: center;
    color: var(--color-green-700);
    font-size: 20px;
  }
  .topic-article__body :global(.note-check) {
    list-style: none;
    padding: 0;
    margin: var(--space-4) 0 var(--space-5);
  }
  .topic-article__body :global(.note-check li) {
    position: relative;
    padding: var(--space-3) 0 var(--space-3) 2em;
    border-bottom: 1px dashed var(--color-line);
    line-height: 1.85;
  }
  .topic-article__body :global(.note-check li::before) {
    content: "";
    position: absolute;
    left: 0.2em;
    top: calc(var(--space-3) + 0.35em);
    width: 1.05em;
    height: 1.05em;
    border: 1.5px solid var(--color-green-700);
    border-radius: 3px;
  }
  .topic-article__body :global(.note-check b) { color: var(--color-green-900); }
  @media (max-width: 640px) {
    .topic-article__body :global(.note-summary__grid) { grid-template-columns: 1fr; }
    .topic-article__body :global(.note-compare) { grid-template-columns: 1fr; }
    .topic-article__body :global(.note-compare__arrow) { transform: rotate(90deg); justify-self: center; line-height: 1; }
  }

  .topic-article__foot {
    margin-top: var(--space-8);
    text-align: center;
  }

  @media (max-width: 768px) {
    .topic-article__title { font-size: 22px; }
  }
</style>
