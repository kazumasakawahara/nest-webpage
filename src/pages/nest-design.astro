---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import CtaBlock from '../components/CtaBlock.astro';
import { site } from '../lib/site';
---

<BaseLayout
  title="nestDesign"
  description="nestDesignは、創造性をテーマにした就労継続支援B型事業所です。デザイン実務豊富なスタッフがあなたの才能を引き出します。"
>
  <Hero
    eyebrow="nestDesign"
    title="創造性をテーマに、"
    titleSub="あなたの才能を引き出す場所。"
    lead="他の作業所とは一味違うnest独自の支援。常に創造性をテーマとしたワークスペースです。"
    size="lg"
    image="/images/nest-image2/nestdesign_shitsunai.png"
    placeholderLabel="NEST DESIGN — アトリエ / 制作風景"
  />

  <!-- ===== コンセプト ===== -->
  <section class="section">
    <div class="container container--narrow reveal">
      <div class="nd-logo-row">
        <img
          class="nd-logo"
          src="/images/nest-image2/nestdesign-logo.png"
          alt="nestDesign"
          width="3087"
          height="2002"
          loading="lazy"
        />
        <img
          class="nd-mentor"
          src="/images/nestdesign-mentor.jpg"
          alt="nestDesignで利用者を指導するベテランデザイナー"
          width="1024"
          height="1536"
          loading="lazy"
        />
      </div>
      <span class="eyebrow eyebrow--center">Our Concept</span>
      <h2 class="section__title section__title--center">個性を描く、おもちゃ箱のアトリエ</h2>
      <div class="prose">
        <p>
          nestDesign は、福祉という枠組みを超え、一人ひとりの感性をアートとして社会へ届ける
          <strong>クリエイティブ・アトリエ</strong>です。「福祉の事業所だから」という応援ではなく、
          作品そのものが持つ力で、見る人の心を動かす——私たちは、そんな新しい福祉の価値を創造しています。
        </p>
      </div>
      <ul class="nd-points">
        <li>
          <strong>唯一無二の感性を、デザインの力で</strong>
          <span>
            メンバーが紡ぎ出す、個性あふれる線や色。そこにプロの視点で「少しの工夫」を添え、
            日常を彩るアートへと昇華させます。オリジナリティを尊重し、手に取った人の心に温かな驚きを届ける——
            デザイン実務豊富なスタッフが、基礎から伴走します。
          </span>
        </li>
        <li>
          <strong>自然体でいられる「おもちゃ箱」</strong>
          <span>
            アトリエに堅苦しさはありません。BGMが流れ、誰もが自分のペースで創作を楽しむ。
            そんな心地よい「居場所」から、枠にとらわれない自由な創造性が生まれています。
          </span>
        </li>
      </ul>
    </div>
  </section>

  <!-- ===== 制作作業 ===== -->
  <section class="section section--sand">
    <div class="container">
      <div class="section-head reveal text-center">
        <span class="eyebrow eyebrow--center">Our Works</span>
        <h2 class="section__title section__title--center">制作作業</h2>
        <p class="section__lead section__lead--center">
          オリジナルグッズやアート作品の企画・制作販売、テキスト入力〜校正、
          ネスト〜木町家の販促物・各種印刷物の企画制作、SNS対応まで——
          創作の輪を広げながら、日常に小さなアートを届けています。
        </p>
      </div>

      <ul class="work-tags reveal">
        <li class="work-tag">オリジナルグッズ企画製作販売</li>
        <li class="work-tag">アート作品製作販売</li>
        <li class="work-tag">テキスト入力〜校正作業</li>
        <li class="work-tag">ネスト全体の販促物企画制作</li>
        <li class="work-tag">各種印刷物企画制作</li>
        <li class="work-tag">クリエイティブワーク全般</li>
      </ul>

      <ul class="nd-points nd-points--works reveal">
        <li>
          <strong>イラスト傘</strong>
          <span>一点ずつメンバーが手描きする、世界に一つだけのパートナー。</span>
        </li>
        <li>
          <strong>卵パックの湿気取り</strong>
          <span>コーヒーかすとリサイクル紙でつくる、エコで愛らしい暮らしの相棒。</span>
        </li>
        <li>
          <strong>日常を彩る創作活動</strong>
          <span>カレンダー制作や空間装飾など、暮らしの中に小さなアートを広げています。</span>
        </li>
      </ul>

      <div class="photo-grid reveal">
        <figure class="photo">
          <img src="/images/nestdesign-work-atelier.jpg" alt="傘の作品が飾られたnestDesignのアトリエで制作する利用者たち" width="760" height="620" loading="lazy" />
          <figcaption>ここはnestのビジュアル発信基地</figcaption>
        </figure>
        <figure class="photo">
          <img src="/images/nestdesign-work-umbrella.jpg" alt="イラスト傘に絵付けをする利用者" width="687" height="760" loading="lazy" />
          <figcaption>世界に一つだけのイラスト傘</figcaption>
        </figure>
        <figure class="photo">
          <img src="/images/nestdesign-work-create.jpg" alt="作品に色を塗る利用者" width="485" height="760" loading="lazy" />
          <figcaption>集中した作業から、思いがけない作品が誕生</figcaption>
        </figure>
        <figure class="photo">
          <img src="/images/nestdesign-work-brush.jpg" alt="さまざまな画材と制作中の作品" width="760" height="489" loading="lazy" />
          <figcaption>さまざまな画材を使って</figcaption>
        </figure>
        <figure class="photo">
          <img src="/images/nestdesign-work-art.jpg" alt="利用者が描いた女性の顔のアート作品" width="760" height="738" loading="lazy" />
          <figcaption>作者の個性が現れる、その個人差が楽しい</figcaption>
        </figure>
        <figure class="photo">
          <img src="/images/nestdesign-work-motto.jpg" alt="「ていねいはいちばんの近道」と書かれた黒板とライオンのアート作品" width="760" height="480" loading="lazy" />
          <figcaption>“ていねい”は、いちばんの近道</figcaption>
        </figure>
      </div>
      <p class="photo-note reveal">※ 掲載している写真は、ご本人の了解を得て掲載しています。</p>

      <!-- 作品集 -->
      <div class="works reveal">
        <div class="works__head">
          <span class="eyebrow eyebrow--center">Gallery</span>
          <h3 class="works__title">利用者の作品集</h3>
          <p class="works__lead">
            アトリエで生まれた作品たちを、壁に飾るようにご紹介します。
            描く人の数だけ、線と色があります。
          </p>
        </div>

        <div class="works__chapter">
          <h4 class="works__chapter-title">描く<span>ペンと絵の具の物語</span></h4>
          <p class="works__chapter-lead">動物、あこがれの人、暮らしの風景。モチーフも画風も、描く人それぞれ。</p>
          <div class="works__wall">
            <figure class="work"><img src="/images/nestdesign-works/work-01.jpg" alt="ひまわりの絵と「あなたの笑顔が素敵」の書" width="675" height="900" loading="lazy" /></figure>
            <figure class="work"><img src="/images/nestdesign-works/work-02.jpg" alt="ギターを構える人物の絵" width="675" height="900" loading="lazy" /></figure>
            <figure class="work"><img src="/images/nestdesign-works/work-03.jpg" alt="木の枝に立つ猫の絵" width="900" height="675" loading="lazy" /></figure>
            <figure class="work"><img src="/images/nestdesign-works/work-04.jpg" alt="額装されたカフェの線画" width="900" height="675" loading="lazy" /></figure>
            <figure class="work"><img src="/images/nestdesign-works/work-05.jpg" alt="クレヨンで描かれたウシやカメレオン、トラたち" width="900" height="589" loading="lazy" /></figure>
            <figure class="work"><img src="/images/nestdesign-works/work-06.jpg" alt="クレヨンで描かれたシマウマやフラミンゴ、サルたち" width="900" height="640" loading="lazy" /></figure>
            <figure class="work"><img src="/images/nestdesign-works/work-07.jpg" alt="YES I CAN と描かれたレタリング作品" width="604" height="900" loading="lazy" /></figure>
            <figure class="work"><img src="/images/nestdesign-works/work-08.jpg" alt="NO MORE WAR と描かれたポスター風レタリング作品" width="671" height="900" loading="lazy" /></figure>
            <figure class="work"><img src="/images/nestdesign-works/work-09.jpg" alt="A Detective's Story のレタリングとライオンの絵" width="610" height="900" loading="lazy" /></figure>
            <figure class="work"><img src="/images/nestdesign-works/work-10.jpg" alt="椅子に腰かけてギターを弾く人物の絵" width="609" height="900" loading="lazy" /></figure>
            <figure class="work"><img src="/images/nestdesign-works/work-11.jpg" alt="色鉛筆で描かれた人物のポートレート" width="900" height="626" loading="lazy" /></figure>
            <figure class="work"><img src="/images/nestdesign-works/work-12.jpg" alt="台所に立つ二人を描いた色鉛筆画" width="628" height="900" loading="lazy" /></figure>
            <figure class="work"><img src="/images/nestdesign-works/work-13.jpg" alt="丘の上の家と色づく木々の風景画" width="605" height="900" loading="lazy" /></figure>
            <figure class="work"><img src="/images/nestdesign-works/work-14.jpg" alt="黄色を基調にしたテーブルの静物画" width="675" height="900" loading="lazy" /></figure>
            <figure class="work"><img src="/images/nestdesign-works/work-15.jpg" alt="メリーゴーラウンドと3人の少女の絵" width="653" height="900" loading="lazy" /></figure>
            <figure class="work"><img src="/images/nestdesign-works/work-16.jpg" alt="部屋に立つ人物を描いた色鉛筆画" width="575" height="900" loading="lazy" /></figure>
          </div>
        </div>

        <div class="works__chapter">
          <h4 class="works__chapter-title">ひらく<span>一点ものの手描き傘</span></h4>
          <p class="works__chapter-lead">傘一本がキャンバス。雨の日がすこし楽しみになる、世界に一つの相棒です。</p>
          <div class="works__wall">
            <figure class="work"><img src="/images/nestdesign-works/work-17.jpg" alt="動物たちが輪になって描かれた手描き傘" width="675" height="900" loading="lazy" /></figure>
            <figure class="work"><img src="/images/nestdesign-works/work-18.jpg" alt="草花が描かれた手描き傘" width="675" height="900" loading="lazy" /></figure>
            <figure class="work"><img src="/images/nestdesign-works/work-19.jpg" alt="鳥たちが並ぶ手描き傘" width="675" height="900" loading="lazy" /></figure>
            <figure class="work"><img src="/images/nestdesign-works/work-20.jpg" alt="ゾウをペイズリー模様で描いた手描き傘" width="675" height="900" loading="lazy" /></figure>
            <figure class="work"><img src="/images/nestdesign-works/work-21.jpg" alt="アトリエに並ぶ手描き傘たち" width="900" height="675" loading="lazy" /></figure>
          </div>
        </div>

        <div class="works__chapter">
          <h4 class="works__chapter-title">暮らしのそばに<span>立体作品とグッズ</span></h4>
          <p class="works__chapter-lead">植木鉢、陶器、紙袋、湿気とり。手から生まれた作品が、日々の暮らしにとけこみます。</p>
          <div class="works__wall">
            <figure class="work"><img src="/images/nestdesign-works/work-22.jpg" alt="黄色い花模様の陶器の鉢" width="900" height="870" loading="lazy" /></figure>
            <figure class="work"><img src="/images/nestdesign-works/work-23.jpg" alt="麻布に並ぶ色とりどりの陶器バッジ" width="874" height="900" loading="lazy" /></figure>
            <figure class="work"><img src="/images/nestdesign-works/work-24.jpg" alt="CIRCUSと描かれた植木鉢" width="900" height="675" loading="lazy" /></figure>
            <figure class="work"><img src="/images/nestdesign-works/work-25.jpg" alt="街並みが描かれた植木鉢" width="628" height="900" loading="lazy" /></figure>
            <figure class="work"><img src="/images/nestdesign-works/work-26.jpg" alt="花の絵をあしらった紙袋" width="833" height="900" loading="lazy" /></figure>
            <figure class="work"><img src="/images/nestdesign-works/work-27.jpg" alt="花のスタンプを押した紙袋" width="675" height="900" loading="lazy" /></figure>
            <figure class="work"><img src="/images/nestdesign-works/work-28.jpg" alt="木のブロックに描かれたミニアートたち" width="900" height="675" loading="lazy" /></figure>
            <figure class="work"><img src="/images/nestdesign-works/work-29.jpg" alt="空き缶にとりつけたゾウのオブジェ" width="900" height="694" loading="lazy" /></figure>
            <figure class="work"><img src="/images/nestdesign-works/work-30.jpg" alt="店頭に並ぶ湿気とりの作品たち" width="900" height="675" loading="lazy" /></figure>
            <figure class="work"><img src="/images/nestdesign-works/work-31.jpg" alt="緑の毛糸の髪をつけた湿気とり" width="900" height="814" loading="lazy" /></figure>
            <figure class="work"><img src="/images/nestdesign-works/work-32.jpg" alt="クマの顔の湿気とり" width="900" height="897" loading="lazy" /></figure>
            <figure class="work"><img src="/images/nestdesign-works/work-33.jpg" alt="ネコの顔の湿気とり" width="900" height="843" loading="lazy" /></figure>
            <figure class="work"><img src="/images/nestdesign-works/work-34.jpg" alt="ネコのイラストが描かれた湿気とり" width="900" height="759" loading="lazy" /></figure>
            <figure class="work"><img src="/images/nestdesign-works/work-35.jpg" alt="花模様に彩色された湿気とり" width="900" height="816" loading="lazy" /></figure>
            <figure class="work"><img src="/images/nestdesign-works/work-36.jpg" alt="花や家の絵を描いた湿気とり" width="900" height="858" loading="lazy" /></figure>
          </div>
        </div>

        <p class="works__note text-soft">※ 作品はすべて、ご本人の了解を得て掲載しています。</p>
      </div>
    </div>
  </section>

  <!-- ===== Instagram ===== -->
  <section class="section ig-section">
    <div class="container container--narrow">
      <a
        href={site.instagramNestDesign}
        class="ig-cta reveal"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="nestDesign の Instagram（@nestdesign328）を新しいタブで開く"
      >
        <span class="ig-cta__glyph" aria-hidden="true">
          <svg width="34" height="34" viewBox="0 0 24 24" fill="none">
            <rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.6" />
            <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.6" />
            <circle cx="17.5" cy="6.5" r="1.1" fill="currentColor" />
          </svg>
        </span>
        <span class="eyebrow eyebrow--center">Instagram</span>
        <h2 class="ig-cta__title">作品づくりの日々はこちら</h2>
        <p class="ig-cta__lead">
          アトリエで生まれる作品やオリジナルグッズ、制作の様子を発信しています。
          フォローして、最新の情報をチェックしてください。
        </p>
        <span class="btn btn--accent btn--lg ig-cta__btn">
          @nestdesign328 をフォロー
          <span class="btn__icon" aria-hidden="true">→</span>
        </span>
      </a>
    </div>
  </section>

  <!-- ===== CTA ===== -->
  <section class="section">
    <div class="container">
      <CtaBlock
        title="あなたの才能を、一緒に育てませんか？"
        body="絵やデザインが好きな方、自分の感性を表現したい方の見学・体験を随時受け付けています。"
        primary={{ label: 'お問い合わせフォーム', href: '/contact/' }}
        secondary={{ label: '木町家もチェック', href: '/kimachiya/' }}
        variant="dark"
      />
    </div>
  </section>
</BaseLayout>

<style>
  .prose p { font-size: 16px; line-height: 2; color: var(--color-ink); }
  .prose p + p { margin-top: var(--space-4); }
  .prose strong { color: var(--color-green-900); font-weight: 600; }

  /* CONCEPT / WORKS の要点。左にテラコッタの罫を引いたエディトリアルなリスト。 */
  .nd-points {
    list-style: none;
    max-width: 760px;
    margin: var(--space-6) auto 0;
    padding: 0;
    display: grid;
    gap: var(--space-5);
  }

  .nd-points li {
    padding-left: var(--space-5);
    border-left: 3px solid var(--color-terra-500);
  }

  .nd-points strong {
    display: block;
    font-family: var(--font-hand);
    font-size: 18px;
    color: var(--color-green-900);
    margin-bottom: var(--space-2);
  }

  .nd-points span {
    display: block;
    font-size: 15px;
    line-height: 1.9;
    color: var(--color-ink);
  }

  /* お仕事内容（業務種別チップ）。PDF パンフレットの業務一覧に対応。 */
  .work-tags {
    list-style: none;
    padding: 0;
    margin: 0 auto var(--space-7);
    max-width: 760px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
  }

  .work-tag {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-green-900);
    background: var(--color-green-100);
    border: 1px solid var(--color-line);
    border-radius: 999px;
    padding: 8px 18px;
  }

  /* WORKS は3点を横並びのカード状に。狭い画面では縦積み。 */
  .nd-points--works {
    max-width: 920px;
    margin-bottom: var(--space-7);
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  @media (max-width: 720px) {
    .nd-points--works { grid-template-columns: 1fr; }
  }

  /* 制作風景ギャラリー */
  .photo-grid {
    max-width: 900px;
    margin: 0 auto var(--space-7);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
  }

  .photo {
    margin: 0;
    background: var(--color-paper);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-soft);
    transition: transform var(--dur-base) var(--ease-out), box-shadow var(--dur-base) var(--ease-out);
  }

  .photo:hover { transform: translateY(-4px); box-shadow: var(--shadow-card); }

  .photo img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .photo figcaption {
    padding: var(--space-3) var(--space-4);
    font-size: 13px;
    line-height: 1.6;
    color: var(--color-ink-mute);
    text-align: center;
  }

  .photo-note {
    max-width: 900px;
    margin: var(--space-4) auto 0;
    font-size: 12px;
    color: var(--color-ink-mute);
    text-align: right;
  }

  @media (max-width: 720px) {
    .photo-grid { grid-template-columns: repeat(2, 1fr); }
  }

  /* === 作品集：壁に飾るように少し傾けて掛けるサロン風ギャラリー === */
  .works {
    max-width: 980px;
    margin: var(--space-8) auto 0;
  }

  .works__head {
    max-width: 640px;
    margin: 0 auto var(--space-7);
    text-align: center;
  }

  .works__title {
    font-family: var(--font-serif);
    font-size: 26px;
    color: var(--color-green-900);
    margin: var(--space-2) 0 var(--space-3);
  }

  .works__lead {
    line-height: 1.9;
    font-size: 15px;
    color: var(--color-ink-mute);
  }

  .works__chapter + .works__chapter { margin-top: var(--space-8); }

  .works__chapter-title {
    font-family: var(--font-hand);
    font-size: 22px;
    color: var(--color-green-900);
    padding-left: var(--space-4);
    border-left: 3px solid var(--color-terra-500);
    margin-bottom: var(--space-2);
  }

  .works__chapter-title span {
    margin-left: var(--space-3);
    font-family: var(--font-serif);
    font-size: 14px;
    color: var(--color-ink-mute);
    letter-spacing: 0.04em;
  }

  .works__chapter-lead {
    font-size: 14px;
    line-height: 1.8;
    color: var(--color-ink-mute);
    margin-bottom: var(--space-5);
    padding-left: calc(var(--space-4) + 3px);
  }

  /* 段組みメイソンリー。作品はトリミングせず、縦横比のまま並べる */
  .works__wall {
    columns: 3;
    column-gap: var(--space-4);
  }

  .work {
    margin: 0 0 var(--space-4);
    break-inside: avoid;
    background: var(--color-paper);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-soft);
    transition: transform var(--dur-base) var(--ease-out), box-shadow var(--dur-base) var(--ease-out);
  }

  /* 手で掛けたようなわずかな傾き。ホバーですっとまっすぐに */
  .work:nth-child(3n + 1) { transform: rotate(-0.7deg); }
  .work:nth-child(3n + 2) { transform: rotate(0.5deg); }
  .work:nth-child(3n)     { transform: rotate(0.9deg); }

  .work:hover {
    transform: rotate(0deg) translateY(-4px);
    box-shadow: var(--shadow-card);
  }

  .work img {
    display: block;
    width: 100%;
    height: auto;
  }

  .works__note {
    margin-top: var(--space-5);
    font-size: 12px;
    text-align: right;
  }

  @media (max-width: 720px) {
    .works__wall { columns: 2; column-gap: var(--space-3); }
    .work { margin-bottom: var(--space-3); }
  }

  @media (prefers-reduced-motion: reduce) {
