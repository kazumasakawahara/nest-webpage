---
// 「私の想い」1件分のカード。full＝全文（一覧ページ）、fold＝見出しと「見る」だけ、押すとその場で全文が開く（親なき後ページ）
import { render, type CollectionEntry } from 'astro:content';
import { OMOI_THEME_LABELS, omoiByline } from '../lib/omoi';

interface Props {
  entry: CollectionEntry<'postParentOmoi'>;
  mode: 'full' | 'fold';
}
const { entry, mode } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const theme = OMOI_THEME_LABELS[data.theme];
const byline = omoiByline(data);
---

{mode === 'full' ? (
  <article class="omoi-card" id={entry.id}>
    <p class="omoi-card__theme">{theme}</p>
    {data.title && <h3 class="omoi-card__title">{data.title}</h3>}
    <div class="omoi-card__body"><Content /></div>
    <p class="omoi-card__byline">{byline}</p>
  </article>
) : (
  <details class="omoi-card omoi-card--fold" id={`omoi-${entry.id}`}>
    <summary class="omoi-card__summary">
      <span class="omoi-card__title">{data.title ?? theme}</span>
      <span class="omoi-card__toggle" aria-hidden="true"><span class="omoi-card__open">見る</span><span class="omoi-card__close">閉じる</span></span>
    </summary>
    <p class="omoi-card__theme">{theme}</p>
    <div class="omoi-card__body"><Content /></div>
    <p class="omoi-card__byline">{byline}</p>
  </details>
)}

<style>
  /* 手紙・便箋を思わせる落ち着いたカード（SNSのタイムライン風にしない） */
  .omoi-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    background: var(--color-paper);
    color: var(--color-ink);
    scroll-margin-top: 80px;
  }
  /* 親なき後ページ：見出しと「見る」だけを並べ、押すとその場で全文を開く */
  .omoi-card--fold { padding: var(--space-4) var(--space-5); }
  .omoi-card--fold[open] { gap: var(--space-3); }
  .omoi-card__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    cursor: pointer;
    list-style: none;
  }
  .omoi-card__summary::-webkit-details-marker { display: none; }
  .omoi-card__toggle {
    flex-shrink: 0;
    padding: 6px 18px;
    border: 1px solid var(--color-green-700);
    border-radius: 999px;
    font-size: 14px;
    font-weight: 600;
    color: var(--color-green-700);
    white-space: nowrap;
  }
  .omoi-card__summary:hover .omoi-card__toggle { background: var(--color-green-700); color: var(--color-cream); }
  .omoi-card__close { display: none; }
  .omoi-card--fold[open] .omoi-card__open { display: none; }
  .omoi-card--fold[open] .omoi-card__close { display: inline; }
  .omoi-card__theme {
    margin: 0;
    font-size: 13px;
    letter-spacing: 0.05em;
    color: var(--color-terra-500);
  }
  .omoi-card__title {
    /* 見出しは文節の途中で折り返さない（h1〜h4 の全体指定と同じ） */
    text-wrap: balance;
    word-break: auto-phrase;
    margin: 0;
    font-family: var(--font-serif);
    font-size: 20px;
    font-weight: 600;
    line-height: 1.6;
    color: var(--color-green-900);
  }
  .omoi-card__body {
    font-family: var(--font-serif);
    font-size: 16px;
    line-height: 2;
    overflow-wrap: anywhere;
  }
  .omoi-card__body :global(p) { margin: 0 0 var(--space-4); }
  .omoi-card__body :global(p:last-child) { margin-bottom: 0; }
  .omoi-card__byline {
    margin: 0;
    align-self: flex-end;
    font-size: 14px;
    color: var(--color-ink-mute);
  }
</style>
