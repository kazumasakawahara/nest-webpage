---
// 教えてAIさんの「NEW」札。ビルド時点で期間内なら描画し、期間が過ぎたら
// BaseLayout のスクリプトが data-hide-after を見て隠す（ビルドし直さなくても外れる）
import { isNew, newUntil } from '../lib/ai-tips-new';

interface Props {
  date: Date;
}

const { date } = Astro.props;
const show = isNew(date, new Date());
---

{show && (
  <span class="ai-new badge" data-hide-after={newUntil(date).toISOString()}>NEW</span>
)}

<style>
  .ai-new {
    padding: 2px 8px;
    background-color: var(--color-terra-500);
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    vertical-align: middle;
    flex: none;
  }
</style>
