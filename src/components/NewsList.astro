---
import { getCollection, render } from 'astro:content';
import { eventEndsAt, eventNotice, findReport } from '../lib/event-news';

interface Props {
  limit?: number;
  showSummary?: boolean;
  /** 指定するとそのタグの記事だけ。未指定なら「研修会」を除く（研修会は /news/training/ に並ぶ。showInNews の記事は除かない） */
  tag?: string;
}

const { limit, showSummary = false, tag } = Astro.props;

const all = await getCollection(
  'news',
  ({ data }) => !data.draft && (tag ? data.tag === tag : data.tag !== '研修会' || data.showInNews),
);
const sorted = all.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const items = limit ? sorted.slice(0, limit) : sorted;
const now = new Date();
// 満席のイベントは題名の頭に「満席」。開催日を過ぎるか開催報告が出たら「終了」（ビルド後に過ぎた分はブラウザ側で切り替え）
const badgeOf = (item: (typeof items)[number]) => {
  const { eventDate, soldOut } = item.data;
  const notice = eventNotice({ eventDate, soldOut, hasReport: !!findReport(all, item.id) }, now);
  const upcoming = notice === 'soldOut' || notice === 'none';
  return { notice, endsAt: upcoming && eventDate ? eventEndsAt(eventDate).toISOString() : undefined };
};

const fmtDate = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
---

<ul class="news-list">
  {
    items.map((item, i) => (
      <li class="news-list__item reveal" data-delay={(i % 3) + 1}>
        <a href={`/news/${item.id}/`} class="news-list__link">
          <time class="news-list__date" datetime={item.data.date.toISOString()}>
            {fmtDate(item.data.date)}
          </time>
          <span class="news-list__tag badge badge--accent">{item.data.tag}</span>
          <h3 class="news-list__title">
            {(() => {
              const { notice, endsAt } = badgeOf(item);
              return (
                <>
                  {notice === 'soldOut' && (
                    <span class="news-list__sold-out badge badge--sold-out" data-hide-after={endsAt}>満席</span>
                  )}
                  {(notice === 'over' || notice === 'report') && (
                    <span class="news-list__sold-out badge badge--closed">終了</span>
                  )}
                  {endsAt && (
                    <span class="news-list__sold-out badge badge--closed" data-show-after={endsAt} hidden>終了</span>
                  )}
                </>
              );
            })()}
            {item.data.title}
          </h3>
          {showSummary && item.data.summary && (
            <p class="news-list__summary">{item.data.summary}</p>
          )}
          <span class="news-list__arrow" aria-hidden="true">
            <svg width="14" height="10" viewBox="0 0 14 10" fill="none">
              <path d="M1 5h12M9 1l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .news-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .news-list__item {
    border-top: 1px solid var(--color-line);
  }

  .news-list__item:last-child {
    border-bottom: 1px solid var(--color-line);
  }

  .news-list__link {
    display: grid;
    grid-template-columns: 120px auto 1fr auto;
    align-items: center;
    gap: var(--space-5);
    padding: var(--space-5) var(--space-4);
    color: var(--color-ink);
    transition: background-color var(--dur-fast) var(--ease-out);
  }

  .news-list__link:hover {
    background-color: rgba(74, 140, 63, 0.04);
    color: var(--color-ink);
  }

  .news-list__date {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-ink-soft);
    letter-spacing: 0.05em;
  }

  .news-list__title {
    font-family: var(--font-hand);
    font-size: 16px;
    font-weight: 500;
    color: var(--color-green-900);
    line-height: 1.6;
  }

  .news-list__sold-out {
    margin-right: var(--space-2);
    vertical-align: 0.1em;
  }

  .news-list__summary {
    grid-column: 3;
    font-size: 13px;
    color: var(--color-ink-mute);
    margin-top: var(--space-2);
  }

  .news-list__arrow {
    color: var(--color-green-700);
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .news-list__link:hover .news-list__arrow {
    transform: translateX(4px);
    color: var(--color-terra-500);
  }

  @media (max-width: 720px) {
    .news-list__link {
      grid-template-columns: 1fr;
      gap: var(--space-2);
      padding: var(--space-4) var(--space-3);
    }

    /* 広い画面用の grid-column: 3 が残ると、見えない列が足されて題がはみ出す */
    .news-list__summary {
      grid-column: auto;
    }

    /* 1列では幅いっぱいに伸びるので、ラベルは文字の幅に戻す */
    .news-list__tag {
      justify-self: start;
    }

    .news-list__arrow {
      display: none;
    }
  }
</style>
